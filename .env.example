# --- Claude (natural-language criteria parsing) ---
# Without this the app falls back to a built-in heuristic parser so the demo still works.
ANTHROPIC_API_KEY=

# --- Cron protection (Vercel sets this header on scheduled invocations) ---
# Used to authorize /api/poll. Generate any random string.
CRON_SECRET=

# --- Email notifications (Resend) ---
# If unset, emails are logged to the server console instead of being sent.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@track-a-ev.app
NOTIFY_EMAIL_TO=

# --- SMS notifications (Twilio) ---
# If unset, SMS messages are logged to the server console instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# --- Demo / offline mode ---
# Tesla's inventory API is unofficial and frequently bot-blocks (HTTP 403).
# Set to 1 to serve deterministic sample inventory so the full pipeline (match,
# notify, dashboard) is demoable without hitting the live API.
TESLA_MOCK=

# When the live Tesla API/webpage can't be reached (e.g. 403 on cloud IPs), the
# app falls back to clearly-labeled SAMPLE data so the UX still works. Set to 0
# to disable the fallback and surface the error instead.
TESLA_SAMPLE_FALLBACK=

# --- Storage ---
# Persistent store (Vercel KV / Upstash Redis). When these are set, tracked
# searches survive across serverless invocations and page refreshes in prod.
# Connect a KV store in the Vercel dashboard (Storage tab) and it injects these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_STORE_KEY=track-a-ev:searches

# Local fallback: path to the JSON file used when no KV store is configured.
# NOTE: Vercel's filesystem is ephemeral, so the file store does NOT persist there.
DATA_FILE=.data/searches.json
