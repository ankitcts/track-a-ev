# --- Claude (natural-language criteria parsing) ---
# Without this the app falls back to a built-in heuristic parser so the demo still works.
ANTHROPIC_API_KEY=

# --- Cron protection (Vercel sets this header on scheduled invocations) ---
# Used to authorize /api/poll. Generate any random string.
CRON_SECRET=

# --- Email notifications (Resend) ---
# If unset, emails are logged to the server console instead of being sent.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@track-a-ev.app
NOTIFY_EMAIL_TO=

# --- SMS notifications (Twilio) ---
# If unset, SMS messages are logged to the server console instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=

# --- Demo / offline mode ---
# Tesla's inventory API is unofficial and frequently bot-blocks (HTTP 403).
# Set to 1 to serve deterministic sample inventory so the full pipeline (match,
# notify, dashboard) is demoable without hitting the live API.
TESLA_MOCK=

# --- Storage ---
# Path to the JSON file used by the default file-backed store (local/dev).
# On Vercel the filesystem is ephemeral; swap store.ts for Vercel KV/Postgres in prod.
DATA_FILE=.data/searches.json
